{
  "name": "@mktbrowser/mcp-server",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "mkt-browser-mcp": "./bin/mkt-browser-mcp.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/standalone.ts",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch",
    "test:managed": "tsx --test src/managed-profile-launch.test.ts src/runtime-license-capacity.test.ts src/tool-exposure-policy.test.ts src/activity-log-redaction.test.ts src/activity-log-allowlist.test.ts src/mcp-tool-authorization.test.ts src/http-transport-auth.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@mktbrowser/profile-manager": "workspace:*",
    "@mktbrowser/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
