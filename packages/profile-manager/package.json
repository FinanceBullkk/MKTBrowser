{
  "name": "@mktbrowser/profile-manager",
  "version": "0.2.9",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:legacy": "node --experimental-strip-types --test src/legacy-multizen-import.test.ts",
    "test:managed": "tsx --test src/managed-profile-create.test.ts",
    "test:deletion": "tsx --test src/permanent-profile-deletion.test.ts"
  },
  "dependencies": {
    "@mktbrowser/types": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2"
  }
}
