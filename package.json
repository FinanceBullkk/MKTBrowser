{
  "name": "mkt-browser",
  "version": "0.3.1",
  "private": true,
  "description": "Internal MKTTool browser profile runtime derived from MultiZen",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspace @mktbrowser/desktop dev",
    "build": "yarn workspaces foreach -A run build",
    "typecheck": "yarn workspaces foreach -A run typecheck",
    "lint": "yarn workspaces foreach -A run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,astro}\"",
    "mcp:dev": "yarn workspace @mktbrowser/mcp-server dev",
    "clean": "rm -rf apps/*/dist apps/*/out packages/*/dist node_modules/.cache"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "yarn@4.5.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
