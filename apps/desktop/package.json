{
  "name": "@mktbrowser/desktop",
  "productName": "MKT Browser",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/patch-electron-info-plist.cjs",
    "dev": "electron-vite dev --watch",
    "build": "node ../../scripts/verify-node-version.cjs && electron-vite build && yarn package:windows-directory",
    "build:mac": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --mac",
    "build:win": "yarn package:windows-installer",
    "build:linux": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --linux",
    "test:w01": "node --experimental-strip-types --test src/main/productIdentity.test.ts",
    "test:w02": "node --test ../../scripts/verify-node-version.test.cjs && node --experimental-strip-types --test src/main/productIdentity.test.ts src/main/mkt-browser-contract.test.ts",
    "test:mkb01": "yarn workspace @mktbrowser/profile-manager test:legacy && node --experimental-strip-types --test src/main/runtime-contract.test.ts src/main/chromium-bootstrap-contract.test.ts src/main/chromium-runtime-path.test.ts src/main/windows-webrtc-firewall.test.ts src/main/socks5-bridge-containment.test.ts src/main/socks5-bridge-http-upstream.test.ts",
    "test:mkb01e": "node --experimental-strip-types --test src/main/security-contract.test.ts",
    "test:mkb02": "yarn workspace @mktbrowser/profile-manager test:managed && yarn workspace @mktbrowser/cdp-driver test:safe && yarn workspace @mktbrowser/mcp-server test:managed && node --experimental-strip-types --test src/main/managed-mode-contract.test.ts src/main/browser-process-discovery.test.ts src/main/proxy-geo-launch.test.ts src/main/extensions/crx-pipeline.test.ts src/main/ipc-runtime-parity.test.ts src/renderer/src/lib/proxy-removal-safety.test.ts",
    "test:mkb03": "yarn workspace @mktbrowser/profile-manager test:deletion && node --experimental-strip-types --test src/main/profile-deletion-lifecycle.test.ts src/main/security-contract.test.ts src/main/windows-local-install-inspector.test.ts src/main/compatibility-engine-pin.test.ts src/main/compatibility-smoke-authorization.test.ts src/main/compatibility-smoke-runner.test.ts src/main/chromium-bootstrap-contract.test.ts",
    "test:packaging": "node --test scripts/edit-windows-executable.test.cjs scripts/emit-windows-compatibility-evidence.test.cjs scripts/fetch-pinned-relay.test.cjs scripts/package-windows-quality-gates.test.cjs scripts/windows-firewall-installer.test.cjs scripts/windows-install-conflict-detection.test.cjs scripts/windows-installer-ownership-fixtures.test.cjs",
    "test:packaging:windows-machine": "powershell.exe -NoProfile -NonInteractive -Command \"$env:MKT_BROWSER_RUN_WINDOWS_MACHINE_INTEGRATION='1'; node --test scripts/windows-installer-ownership-fixtures.test.cjs\"",
    "lint": "node ../../node_modules/typescript/bin/tsc --noEmit -p tsconfig.json --noUnusedLocals --noUnusedParameters --noFallthroughCasesInSwitch",
    "package:windows-directory": "node ./scripts/package-windows-directory.cjs",
    "package:windows-installer": "node ../../scripts/verify-node-version.cjs && electron-vite build && node ./scripts/package-windows-installer.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@mktbrowser/cdp-driver": "workspace:*",
    "@mktbrowser/mcp-server": "workspace:*",
    "@mktbrowser/profile-manager": "workspace:*",
    "@mktbrowser/settings-store": "workspace:*",
    "@mktbrowser/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^12.11.1",
    "chrome-remote-interface": "^0.33.3",
    "emoji-mart": "^5.6.0",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.0.0",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^0.469.0",
    "proxy-chain": "^2.7.1",
    "socks": "^2.8.3",
    "socks-proxy-agent": "^10.0.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.8.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "rcedit": "5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3"
  }
}
