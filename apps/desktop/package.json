{
  "name": "@mktbrowser/desktop",
  "productName": "MKT Browser",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/patch-electron-info-plist.cjs",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --dir",
    "build:mac": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --mac",
    "build:win": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --win",
    "build:linux": "electron-vite build && node ./scripts/strip-workspace-symlinks.cjs && electron-builder --linux",
    "test:w01": "node --experimental-strip-types --test src/main/productIdentity.test.ts",
    "test:w02": "node --experimental-strip-types --test src/main/productIdentity.test.ts src/main/mkt-browser-contract.test.ts",
    "test:mkb01": "node --experimental-strip-types --test src/main/runtime-contract.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@mktbrowser/cdp-driver": "workspace:*",
    "@mktbrowser/mcp-server": "workspace:*",
    "@mktbrowser/profile-manager": "workspace:*",
    "@mktbrowser/settings-store": "workspace:*",
    "@mktbrowser/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "better-sqlite3": "^11.7.0",
    "chrome-remote-interface": "^0.33.3",
    "emoji-mart": "^5.6.0",
    "extract-zip": "^2.0.1",
    "framer-motion": "^12.0.0",
    "https-proxy-agent": "^9.0.0",
    "lucide-react": "^0.469.0",
    "proxy-chain": "^2.7.1",
    "socks": "^2.8.3",
    "socks-proxy-agent": "^10.0.0",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "rcedit": "5.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3"
  }
}
